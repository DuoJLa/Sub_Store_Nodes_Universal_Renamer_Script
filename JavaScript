        countryName = explicitMatch[0];
      } else {
        const chineseMatch = name.match(/[\u4e00-\u9fa5]{2,4}/);
        countryName = chineseMatch ? chineseMatch[0] : (iso || '未知');
      }
    }
    if (countryName === '新加坡') countryName = '狮城'; 

    // --- 节点类型提取 ---
    let nodeType = '';
    const typeMatch = name.match(/(直连|高速|专线|家宽)/);
    if (typeMatch) {
      nodeType = typeMatch[1];
    }

    // --- 倍率提取 ---
    const rateMatch = name.match(/(\d+(?:\.\d+)?)\s*[xX]/);
    let rateStr = '';
    if (rateMatch) {
      const rateValue = parseFloat(rateMatch[1]);
      if (rateValue !== 1) rateStr = `${rateMatch[1]}x`;
    }

    // --- 排序序号提取 ---
    const nameWithoutRate = name.replace(/\d+(\.\d+)?\s*[xX]/g, '');
    const chineseAnchorMatch = nameWithoutRate.match(/[\u4e00-\u9fa5]+/);
    let order = '';
    
    const orderRegex = /(?:^|[^a-zA-Z])([A-Za-z])(?![a-zA-Z])|([A-Za-z]?\d+)/;
    
    if (chineseAnchorMatch) {
      const anchorIndex = nameWithoutRate.indexOf(chineseAnchorMatch[0]);
      const afterAnchor = nameWithoutRate.substring(anchorIndex + chineseAnchorMatch[0].length);
      
      const match = afterAnchor.match(orderRegex);
      if (match) {
        order = (match[1] || match[2]).toUpperCase();
        if (/^\d+$/.test(order)) order = order.padStart(2, '0');
      }
    } else {
      const fallbackMatch = nameWithoutRate.match(orderRegex);
      if (fallbackMatch) {
        order = (fallbackMatch[1] || fallbackMatch[2]).toUpperCase();
        if (/^\d+$/.test(order)) order = order.padStart(2, '0');
      }
    }

    // --- 暂存排序依据 ---
    proxy._countryName = countryName;
    proxy._type = nodeType;
    proxy._order = order || '999';

    // --- 动态拼接名称 ---
    const nameParts = [flag, countryName];
    if (nodeType) nameParts.push(nodeType);
    if (order) nameParts.push(order);
    if (rateStr) nameParts.push(rateStr);

    proxy.name = nameParts.join(' ');
    return proxy;
  });

  // 7. 三级复合排序：地区/大洲 -> 类型 -> 序号
  processedProxies.sort((a, b) => {
    // 第一层：地区/大洲综合权重比较
    // 优先读取 explicitRegionWeights，如果不存在则通过 getContinentWeight 获取大洲排位
    const weightA = explicitRegionWeights[a._countryName] || getContinentWeight(a._countryName);
    const weightB = explicitRegionWeights[b._countryName] || getContinentWeight(b._countryName);
    if (weightA !== weightB) {
      return weightA - weightB;
    }
    
