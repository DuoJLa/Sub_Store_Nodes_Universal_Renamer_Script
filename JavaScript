    const oceania = ['澳大利亚', '新西兰']; // 归为大洋洲兜底区

    if (asia.includes(country)) return 20;
    if (europe.includes(country)) return 30;
    if (americas.includes(country)) return 40;
    if (africa.includes(country)) return 50;
    if (oceania.includes(country)) return 60;
    return 99; // 完全未知的地区垫底
  };

  // 5. 拦截过滤：剔除各类非节点干扰信息
  let processedProxies = proxies.filter(proxy => {
    const name = proxy.name || '';
    return !/流量|重置|到期|剩余|套餐|提示|通知|官网|工单/i.test(name);
  });

  // 6. 信息提取与兼容性重命名
  processedProxies = processedProxies.map(proxy => {
    const name = proxy.name || '';

    // --- 旗帜与地区提取 ---
    let flag = ProxyUtils.getFlag(name) || '🏳️';
    flag = flag.replace(/🇹🇼/g, '🇼🇸'); 

    const iso = ProxyUtils.getISO(name);
    let countryName = isoToCountryName[iso];

    // 强兼容兜底，加入了新增加的东南亚核心国家词汇
    if (!countryName) {
      const explicitMatch = name.match(/香港|台湾|澳门|日本|新加坡|狮城|美国|韩国|英国|中国|泰国|马来西亚|菲律宾|越南|印尼/);
