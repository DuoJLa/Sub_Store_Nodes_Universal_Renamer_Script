async function operator(proxies, targetPlatform, context) {

  // 模块一：ISO 二位代码 → 中文地区名称映射表
  const isoToCountryName = {
    'HK': '香港', 'TW': '台湾', 'MO': '澳门', 'JP': '日本', 'SG': '狮城',
    'US': '美国', 'KR': '韩国', 'GB': '英国', 'UK': '英国', 'CN': '中国',
    'DE': '德国', 'FR': '法国', 'RU': '俄罗斯', 'CA': '加拿大',
    'AU': '澳大利亚', 'NZ': '新西兰', 'NL': '荷兰', 'MY': '马来西亚',
    'TH': '泰国', 'VN': '越南', 'PH': '菲律宾', 'ID': '印尼', 'IN': '印度',
    'AE': '阿联酋', 'SA': '沙特', 'TR': '土耳其', 'IT': '意大利', 'ES': '西班牙',
    'CH': '瑞士', 'SE': '瑞典', 'NO': '挪威', 'DK': '丹麦', 'FI': '芬兰',
    'PL': '波兰', 'IE': '爱尔兰', 'PT': '葡萄牙', 'AT': '奥地利', 'BR': '巴西',
    'AR': '阿根廷', 'CL': '智利', 'ZA': '南非', 'EG': '埃及', 'NG': '尼日利亚',
    'MX': '墨西哥', 'KH': '柬埔寨', 'MM': '缅甸', 'LA': '老挝', 'BD': '孟加拉',
    'PK': '巴基斯坦', 'LK': '斯里兰卡', 'KZ': '哈萨克斯坦', 'UA': '乌克兰',
    'CZ': '捷克', 'HU': '匈牙利', 'IS': '冰岛'
  };

  // 模块二：排序权重表（地区权重 + 类型权重 + 大洲权重）
  const explicitRegionWeights = {
    '香港': 1, '台湾': 2, '澳门': 3, '日本': 4, '狮城': 5,
    '美国': 6, '韩国': 7, '泰国': 8, '马来西亚': 9, '菲律宾': 10,
    '越南': 11, '印尼': 12
  };

  const typeWeights = { '专线': 1, '高速': 2, '直连': 3, '家宽': 4 };

  const getContinentWeight = (country) => {
    const asia     = ['中国', '印度', '阿联酋', '沙特', '土耳其', '柬埔寨', '缅甸', '老挝', '孟加拉', '巴基斯坦', '斯里兰卡', '哈萨克斯坦'];
    const europe   = ['英国', '德国', '法国', '俄罗斯', '荷兰', '意大利', '西班牙', '瑞士', '瑞典', '挪威', '丹麦', '芬兰', '波兰', '爱尔兰', '葡萄牙', '奥地利', '乌克兰', '捷克', '匈牙利', '冰岛'];
    const americas = ['加拿大', '巴西', '阿根廷', '智利', '墨西哥'];
    const africa   = ['南非', '埃及', '尼日利亚'];
    const oceania  = ['澳大利亚', '新西兰'];
    if (asia.includes(country))     return 20;
    if (europe.includes(country))   return 30;
    if (americas.includes(country)) return 40;
    if (africa.includes(country))   return 50;
    if (oceania.includes(country))  return 60;
    return 99;
  };

  // 模块三：倍率正则
  const RATE_PATTERN = '\\d+(?:\\.\\d+)?\\s*[xX]\\b|\\b[xX]\\s*\\d+(?:\\.\\d+)?';
  const RATE_MATCH_REGEX = new RegExp(RATE_PATTERN);
  const RATE_STRIP_REGEX = new RegExp(RATE_PATTERN, 'g');

  // 模块四：序号识别
  const extractRawOrder = (rawStr) => {
    const numMatches = [...rawStr.matchAll(/\d{1,3}/g)];
    if (numMatches.length > 0) {
      return { type: 'number', raw: numMatches[numMatches.length - 1][0] };
    }
    const alphaMatches = [...(' ' + rawStr).matchAll(/(?:[^a-zA-Z0-9])([A-Za-z])(?=[^a-zA-Z0-9]|$)/g)];
    if (alphaMatches.length > 0) {
      return { type: 'alpha', raw: alphaMatches[alphaMatches.length - 1][1].toUpperCase() };
    }
    return { type: 'none', raw: '' };
  };

  // 模块五：字母序号标注
  const toAlphaLabel = (n) => {
    let s = '';
    while (n > 0) {
      s = String.fromCharCode(65 + ((n - 1) % 26)) + s;
      n = Math.floor((n - 1) / 26);
    }
    return s;
  };

  // 模块六：节点过滤
  let processedProxies = proxies.filter(proxy => {
    const name = proxy.name || '';
    return !/群|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|无法|说明|使用|提示|特别|访问|支持|教程|关注|更新|作者|加入|超时|收藏|福利|好友|失联/i.test(name);
  });

  // 模块七：信息提取
  processedProxies = processedProxies.map(proxy => {
    const originalName = proxy.name || '';

    let flag = ProxyUtils.getFlag(originalName) || '🏳️';
    flag = flag.replace(/🇹🇼/g, '🇼🇸');

    const iso = ProxyUtils.getISO(originalName);
    let countryName = isoToCountryName[iso];
    if (!countryName) {
      const explicitMatch = originalName.match(/香港|台湾|澳门|日本|新加坡|狮城|美国|韩国|英国|中国|泰国|马来西亚|菲律宾|越南|印尼/);
      if (explicitMatch) {
        countryName = explicitMatch[0];
      } else {
        const chineseMatch = originalName.match(/[\u4e00-\u9fa5]{2,4}/);
        countryName = chineseMatch ? chineseMatch[0] : (iso || '未知');
      }
    }
    if (countryName === '新加坡') countryName = '狮城';

    let nodeType = '';
    const typeMatch = originalName.match(/(IEPL|直连|高速|专线|家宽)/i);
    if (typeMatch) nodeType = /IEPL/i.test(typeMatch[1]) ? '专线' : typeMatch[1];

    const rateMatch = originalName.match(RATE_MATCH_REGEX);
    let rateStr = '';
    if (rateMatch) {
      const rateNumStr = rateMatch[0].replace(/[xX]/g, '').trim();
      if (parseFloat(rateNumStr) !== 1) rateStr = `${rateNumStr}x`;
    }

    const nameWithoutRate = originalName.replace(RATE_STRIP_REGEX, '');
    const searchStr = (countryName !== '未知' && nameWithoutRate.includes(countryName))
      ? nameWithoutRate.substring(nameWithoutRate.indexOf(countryName) + countryName.length)
      : nameWithoutRate;
    const rawOrder = extractRawOrder(searchStr);

    proxy._flag         = flag;
    proxy._countryName  = countryName;
    proxy._type         = nodeType;
    proxy._rateStr      = rateStr;
    proxy._rawOrderType = rawOrder.type;
    proxy._originalName = originalName;

    return proxy;
  });

  // 模块八：分组序号标注——按"旗帜+地区+类型"分组，组内按原始名称字典序排列，
  const groups = {};
  processedProxies.forEach(proxy => {
    const prefix = `${proxy._flag}|${proxy._countryName}|${proxy._type}`;
    (groups[prefix] ??= []).push(proxy);
  });

  Object.values(groups).forEach(group => {
    const sortedGroup = [...group].sort((a, b) =>
      a._originalName.localeCompare(b._originalName, 'zh-Hans-CN', { numeric: true, sensitivity: 'base' })
    );

    let numCounter = 0;
    let alphaCounter = 0;

    sortedGroup.forEach(proxy => {
      if (proxy._rawOrderType === 'number') {
        proxy._order = String(++numCounter).padStart(2, '0');
      } else if (proxy._rawOrderType === 'alpha') {
        proxy._order = toAlphaLabel(++alphaCounter);
      } else {
        proxy._order = '\uFFFF';
      }
    });
  });

  // 模块九：最终名称拼接——旗帜 + 地区 + 类型 + 序号 + 倍率
  processedProxies.forEach(proxy => {
    const nameParts = [proxy._flag, proxy._countryName];
    if (proxy._type)                nameParts.push(proxy._type);
    if (proxy._order !== '\uFFFF')  nameParts.push(proxy._order);
    if (proxy._rateStr)             nameParts.push(proxy._rateStr);
    proxy.name = nameParts.join(' ');
  });

  // 模块十：多级复合排序——地区/大洲权重 → 类型权重 → 序号值 → 原始名称兜底
  processedProxies.sort((a, b) => {
    const weightA = explicitRegionWeights[a._countryName] || getContinentWeight(a._countryName);
    const weightB = explicitRegionWeights[b._countryName] || getContinentWeight(b._countryName);
    if (weightA !== weightB) return weightA - weightB;

    const typeWeightA = typeWeights[a._type] || 99;
    const typeWeightB = typeWeights[b._type] || 99;
    if (typeWeightA !== typeWeightB) return typeWeightA - typeWeightB;

    if (a._order !== b._order) {
      return a._order.localeCompare(b._order, 'en', { numeric: true });
    }

    return a._originalName.localeCompare(b._originalName, 'en', { numeric: true });
  });

  // 模块十一：清理
  return processedProxies.map(proxy => {
    delete proxy._flag;
    delete proxy._countryName;
    delete proxy._type;
    delete proxy._rateStr;
    delete proxy._rawOrderType;
    delete proxy._order;
    delete proxy._originalName;
    return proxy;
  });
}
